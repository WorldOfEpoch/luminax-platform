      "ui_markers": [
        {
          "path": "luminax-ui/index.html",
          "pattern": "id=\"codexView\""
        },
        {
          "path": "luminax-ui/index.html",
          "pattern": "loadCodexDashboard()"
        }
      ],
      "notes": "Structured Codex runs, sessions, and project bootstrap flow."
