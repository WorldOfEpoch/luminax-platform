# Optional legacy Windows operator settings. Copy to .env.windows only when needed.
# Local Compose setup instead uses payload/tools/initialize_local_config.py.
# This file contains no credential defaults and does not install/start anything.
LUMINAX_HOSTNAME=
LUMINAX_USERNAME=
LUMINAX_KEY_PATH=
LUMINAX_SSH_PORT=22
LUMINAX_REMOTE_BASE_DIR=
LUMINAX_SERVER_BASE_URL=
LUMINAX_WEB_BASE_URL=
LUMINAX_CONTROL_TOKEN=
LUMINAX_NODE_KEY=
LUMINAX_PRIVATE_CONTROL_URL=
LUMINAX_PRIVATE_CONTROL_MODE=ssh_tunnel
LUMINAX_LOCAL_UI_URL=http://127.0.0.1:6969
LUMINAX_INSTALL_ROOT=
LUMINAX_MODEL_DATA_ROOT=
LUMINAX_TUNNEL_LOCAL_HOST=127.0.0.1
LUMINAX_TUNNEL_LOCAL_PORT=18040
LUMINAX_TUNNEL_TARGET_HOST=127.0.0.1
LUMINAX_TUNNEL_TARGET_PORT=8040

# Desktop configuration may be supplied in the process environment.
LUMINAX_SHELL_URL=http://127.0.0.1:6969

# Development tools read only an explicitly selected project settings file.
# Set these in the process environment used to launch Python/Unity.
DARIUS_ENV_FILE=
LUMINAX_TOOLS_ENV_FILE=
DARIUS_PROJECT_ROOT=
MESHY_API_KEY=
